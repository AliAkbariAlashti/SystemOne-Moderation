# Copy this file to .env and set the value locally. Never commit the real key.
TYPESAFE_API_KEY=
PORT=8080
POLICY_PATH=config/policy.json

# RabbitMQ is the primary application integration path in Docker Compose.
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
AMQP_INPUT_QUEUE=moderation.requests
AMQP_OUTPUT_QUEUE=moderation.results
HTTP_ENABLED=true
# Consumers per worker container. Use replicas for most horizontal scaling.
WORKER_CONCURRENCY=1

# Optional bearer token protecting /v1/*; set for shared deployments.
MODERATION_API_TOKEN=
